# ─────────────────────────────────────────────────────────────
# peaceskill.sheisai.ai — env vars
# Copy to .env.local for dev, set in Vercel Project Settings for prod.
# ─────────────────────────────────────────────────────────────

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Flodesk
# NOTE: brief assumes one API key + two segment IDs. Amanda supplied two keys
# ("free" + "pro") — likely two separate Flodesk accounts. Set both and the
# free/pro split routes to the right account.
FLODESK_API_KEY_FREE=fd_key_...
FLODESK_API_KEY_PRO=fd_key_...
FLODESK_SEGMENT_FREE=
FLODESK_SEGMENT_PRO=

# App
NEXT_PUBLIC_APP_URL=https://peaceskill.sheisai.ai

# Vercel Postgres (auto-populated when you link a Postgres store)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Plausible (optional — comment out the script tag in layout if unused)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=peaceskill.sheisai.ai
